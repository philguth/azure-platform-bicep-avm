{
  "name": "Azure Bicep + AVM",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "github.vscode-github-actions"
      ],
      "settings": {
        "bicep.enableLinting": true
      }
    }
  },
  "postCreateCommand": "bicep --version"
}
